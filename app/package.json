{
  "name": "@stellar-scaffold/ui-react",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev": "npm start",
		"start": "concurrently --kill-others-on-fail --names stellar,vite,mesa -c gray,green,yellow --pad-prefix \"stellar scaffold watch --build-clients\" \"vite\" \"node ../server/index.mjs\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier . --write",
    "typecheck": "tsc -b",
    "contracts:build": "stellar scaffold build --build-clients"
  },
  "dependencies": {
    "@cavos/kit": "0.2.5",
    "@react-three/drei": "^10.0.0",
    "@react-three/fiber": "^9.1.0",
    "@react-three/postprocessing": "^3.0.4",
    "postprocessing": "^6.37.0",
    "@stellar-scaffold/app-lib": "*",
    "@stellar/stellar-sdk": "^16.0.1",
    "@tanstack/react-query": "^5.90.17",
    "@theahaco/contract-explorer": "^1.1.0",
    "@theahaco/ts-config": "^1.3.0",
    "@trustless-work/escrow": "3.0.5",
    "lossless-json": "^4.3.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-router-dom": "^7.12.0",
    "three": "^0.171.0",
    "liquid-glass-react": "^1.1.1",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@types/lodash": "^4.17.24",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^6.0.0",
    "concurrently": "^9.2.1",
    "dotenv": "^17.4.2",
    "eslint": "^10.0.0",
    "glob": "^13.0.6",
    "globals": "^17.6.0",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vite-plugin-node-polyfills": "^0.28.0",
    "vite-plugin-wasm": "^3.6.0"
  },
  "prettier": "@theahaco/ts-config/prettier",
  "engines": {
    "stellar-scaffold": ">=0.0.28"
  }
}
